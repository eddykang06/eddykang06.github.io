---
import PageLayout from "@/layouts/Base.astro";

const meta = {
	description: "I'm a starter theme for Astro.build",
	title: "About",
};
---

<PageLayout meta={meta}>
	<h1 class="title mb-12">About</h1>
	<div class="prose prose-sm prose-cactus max-w-none">
		<p>
			I’m a student and researcher interested in machine learning, generative modeling, and
			applications in biology.
		</p>

		<h2 class="title mt-8 mb-3 text-xl">Education</h2>
		<div class="space-y-1">
			<div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between">
				<strong>Harvard University</strong>
				<span class="text-muted">Expected May 2028</span>
			</div>
			<p class="m-0">Concurrent Degrees: M.A. Statistics; B.A. Applied Mathematics: Biology</p>
			<p class="m-0">Minor in Computer Science (GPA 3.98)</p>
			<p class="m-0">
				Relevant Coursework: Machine Learning, Diffusion Models, Deep Learning for Molecular
				Biology, Linear Models, Algorithms
			</p>
		</div>

		<h2 class="title mt-8 mb-3 text-xl">Experience</h2>
		<ul class="list-inside list-disc" role="list">
			<li>Building projects at the intersection of machine learning and biology</li>
			<li>Exploring generative approaches for scientific and biological problems</li>
		</ul>

		<h2 class="title mt-8 mb-3 text-xl">Teaching</h2>
		<ul class="list-inside list-disc" role="list">
			<li>Interested in communicating technical ideas clearly and accessibly</li>
			<li>Enjoy helping others learn through thoughtful explanations and examples</li>
		</ul>
	</div>
</PageLayout>

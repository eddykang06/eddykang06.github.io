---
import { Icon } from "astro-icon/components";
import { linkGroups } from "@/data/links";
import PageLayout from "@/layouts/Base.astro";

const populatedGroups = linkGroups.filter((group) => group.links.length > 0);

const meta = {
	description: "A collection of music, writing, textbooks, videos, and other interesting finds.",
	title: "Links",
};
---

<PageLayout meta={meta}>
	<h1 class="title mb-4">Links</h1>
	<p class="text-muted mb-8">Links to some of my favorite things.</p>

	{
		populatedGroups.length > 0 ? (
			<div class="space-y-10">
				{populatedGroups.map((group) => (
					<section>
						<h2 class="title mb-3 text-xl">{group.title}</h2>
						<ul class="marker:text-muted list-disc space-y-0 pl-5" role="list">
							{group.links.map((link) => (
								<li>
									<a
										class="group flex items-start justify-between gap-4 rounded-md py-1"
										href={link.url}
										rel="noopener noreferrer"
										target="_blank"
									>
										<span>
											<span class="text-accent font-medium">{link.title}</span>
											{link.description && (
												<span class="text-muted mt-1 block text-sm leading-6">
													{link.description}
												</span>
											)}
										</span>
										<Icon
											aria-hidden="true"
											class="text-muted mt-0.5 h-5 w-5 shrink-0 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
											name="mdi:open-in-new"
										/>
									</a>
								</li>
							))}
						</ul>
					</section>
				))}
			</div>
		) : (
			<p class="text-muted py-6 text-sm">Nothing here yet.</p>
		)
	}
</PageLayout>
